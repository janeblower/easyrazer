{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main", "devtools"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
