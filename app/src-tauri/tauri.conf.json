{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyRazer",
  "version": "0.1.0",
  "identifier": "net.easyrazer.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "EasyRazer", "width": 1160, "height": 912, "minWidth": 1160, "minHeight": 912, "visible": false }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
